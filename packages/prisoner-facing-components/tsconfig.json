{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./src/assets/**/*.ts"]
}
