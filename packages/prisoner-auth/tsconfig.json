{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/__tests__/**"],
}
